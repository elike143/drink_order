# 資料庫使用者名稱，PostgreSQL 容器第一次啟動時會用它建立帳號
POSTGRES_USER=drinks_user

# 資料庫密碼，這裡只是假值；真實密碼只寫在你自己的 .env
POSTGRES_PASSWORD=change_me

# 資料庫名稱，容器啟動時會自動建立這個資料庫
POSTGRES_DB=drinks

# 後端程式連線資料庫用的網址，格式是 驅動名://帳號:密碼@主機:連接埠/資料庫名
# 之後程式放進 Docker 容器內執行時，主機要從 localhost 改成服務名稱 db
DATABASE_URL=postgresql+psycopg://drinks_user:change_me@localhost:5432/drinks

# 後台管理 API 的存取密碼，這裡是假值
ADMIN_TOKEN=change_me_too